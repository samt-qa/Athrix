{
  "name": "athrix-desktop",
  "version": "0.0.1",
  "description": "Athrix desktop app",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "worker": "node scripts/build-worker.mjs",
    "worker:release": "node scripts/build-worker.mjs --release",
    "serve": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "typecheck": "tsc --noEmit",
    "check:query": "node --experimental-strip-types --no-warnings src/lib/queryLang.selfcheck.ts"
  },
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-opener": "~2.5.0",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12"
  },
  "private": true,
  "license": "MIT OR Apache-2.0"
}
