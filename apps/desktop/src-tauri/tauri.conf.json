{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Athrix",
  "version": "0.0.1",
  "identifier": "com.samt.athrix",
  "build": {
    "beforeDevCommand": "npm run worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run worker && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Athrix",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "center": true
      },
      {
        "label": "quick",
        "title": "Athrix",
        "url": "index.html",
        "width": 776,
        "height": 596,
        "center": true,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: athrix-preview: http://athrix-preview.localhost; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/athrix-extract-worker"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
